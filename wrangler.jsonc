{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wonder-pads-content-studio",
  "compatibility_date": "2026-09-13",
  "main": "./worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
